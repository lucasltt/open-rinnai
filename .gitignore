# Publicar somente fontes e documentação selecionadas deste workspace.
# APKs, descompilação, credenciais, capturas e firmwares locais ficam de fora.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/LICENSE
!/LICENSE.*
!/NOTICE
!/CHANGELOG.md
!/PUBLICATION_REPORT.json
!/.github/
!/docs/
!/esphome/
!/analysis/
!/home_assistant/

/esphome/*
!/esphome/*.h
!/esphome/*.yaml
!/esphome/API_LOCAL.md
!/esphome/packages/
!/esphome/dashboard/
!/esphome/api/
/esphome/secrets.yaml
/esphome/secrets.*.yaml
!/esphome/secrets.example.yaml
/esphome/rinnai-local.yaml
/esphome/firmware/
/esphome/.esphome/

/analysis/*
!/analysis/build_pwa_assets.py
!/analysis/embed_pwa_assets.py
!/analysis/embed_api_assets.py
!/analysis/create_secrets.py
!/analysis/export_github.py
!/analysis/check_api_v1_http.py
!/analysis/protocol_inspector.py
!/analysis/test_protocol_inspector.py
!/analysis/run_api_backend_test.py
!/analysis/check_sessions_http.py
!/analysis/test_*.cpp
!/analysis/stubs/

**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
**/.pytest_cache/
**/.ruff_cache/
**/*.apk
**/*.xapk
**/*.bin
**/*.elf
**/*.log
**/.env
**/.env.*
**/secrets.yaml
**/secrets.*.yaml
!**/secrets.example.yaml
